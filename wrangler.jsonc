{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahyaghnova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f6c13fd7-efb5-4d9e-87ba-c79ffb3aa945","database_name": "mahyaghnova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3eb02921e0824931ba77282de85aa2b8" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
